{
  "name": "dsh-disk-cleaner",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin that frees space on a full Windows drive: scan with WizTree, delete regenerable junk, move folders to another volume behind a junction. Dry-run by default.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "disk-cleanup",
    "disk-space",
    "wiztree",
    "c-drive",
    "junction",
    "windows"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Disk Cleaner 磁盘清理",
    "summary": "给塞满的 Windows 系统盘腾空间：WizTree 扫描定位、白名单清理可再生垃圾、把大目录搬到其他盘并留联接，默认 dry-run。",
    "categories": [
      "系统"
    ],
    "surfaces": [
      "host"
    ],
    "compatibility": {
      "dsh": ">=0.2.1-rc.5",
      "node": ">=22"
    },
    "permissions": {}
  },
  "author": "lvyue1314",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvyue1314/dsh-disk-cleaner.git"
  },
  "homepage": "https://github.com/lvyue1314/dsh-disk-cleaner#readme",
  "bugs": {
    "url": "https://github.com/lvyue1314/dsh-disk-cleaner/issues"
  }
}
